# Copy to /etc/msr-v9/station.env; chmod 600; never commit actual values.
MSR_MEDIA_ROOT=/srv/msr-v9-media
MSR_REQUIRE_MEDIA_MOUNT=1
MSR_MOUNT_CHECK_PATH=/srv/msr-v9-media
MSR_DB_PATH=/var/lib/msr-v9/station.sqlite3
MSR_BIND=127.0.0.1
MSR_PORT=17600
MSR_ADMIN_TOKEN=CHANGE_TO_LONG_RANDOM_TOKEN
MSR_PUBLIC_ORIGIN=https://cauctomanu-dotcom.github.io,https://manustreamradio.duckdns.org
MSR_ICECAST_HOST=127.0.0.1
MSR_ICECAST_MOUNT=/manustream-v9-test
MSR_ICECAST_PASSWORD=SET_ICECAST_SOURCE_PASSWORD
MSR_HARBOR_PASSWORD=SET_DIFFERENT_STRONG_STUDIO_PASSWORD
MSR_ICECAST_STATUS_URL=http://127.0.0.1:8000/status-json.xsl
MSR_MAX_UPLOAD_BYTES=1073741824
